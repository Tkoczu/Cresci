#!/usr/bin/env bash

set -e

APP_DIR="/opt/cresci"
SERVICE="cresci"

COMMAND="${1:-help}"

case "${COMMAND}" in

  update)
    exec "${APP_DIR}/scripts/update.sh"
    ;;

  status)
    systemctl status "${SERVICE}" --no-pager
    ;;

  version)
    cd "${APP_DIR}"
    git describe --tags --exact-match 2>/dev/null || git rev-parse --short HEAD
    ;;

  logs)
    journalctl -u "${SERVICE}" -n 100 --no-pager
    ;;

  restart)
    systemctl restart "${SERVICE}"
    echo "CRESCI restarted."
    ;;

  start)
    systemctl start "${SERVICE}"
    echo "CRESCI started."
    ;;

  stop)
    systemctl stop "${SERVICE}"
    echo "CRESCI stopped."
    ;;

  backup)
    TIMESTAMP="$(date +%Y-%m-%d_%H-%M-%S)"
    BACKUP_DIR="/var/backups/cresci/${TIMESTAMP}"

    mkdir -p "${BACKUP_DIR}"

    if [ -f "${APP_DIR}/.env" ]; then
      cp "${APP_DIR}/.env" "${BACKUP_DIR}/.env"
    fi

    if [ -d "${APP_DIR}/data" ]; then
      tar -czf "${BACKUP_DIR}/data.tar.gz" -C "${APP_DIR}" data
    fi

    echo "Backup created:"
    echo "${BACKUP_DIR}"
    ;;

  help|*)
    echo
    echo "CRESCI Management CLI"
    echo
    echo "Usage:"
    echo "  cresci status"
    echo "  cresci version"
    echo "  cresci update"
    echo "  cresci backup"
    echo "  cresci logs"
    echo "  cresci restart"
    echo "  cresci start"
    echo "  cresci stop"
    echo
    ;;

esac